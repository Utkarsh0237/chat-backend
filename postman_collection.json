{
  "info": {
    "name": "Chat Backend API Collection",
    "description": "Postman Collection for Production-Quality Chat Backend including Health Check, User Endpoints (Create User dev-only & Get User), 6 Core Chat/Messaging APIs, Group Chat Management, and Message Editing/Soft Deletion (PostgreSQL + Firebase Firestore). Set the collection variable authToken when AUTH_REQUIRED=true.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{authToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "authToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "userAId",
      "value": "a0000000-0000-0000-0000-000000000001",
      "type": "string"
    },
    {
      "key": "userBId",
      "value": "b0000000-0000-0000-0000-000000000002",
      "type": "string"
    },
    {
      "key": "userCId",
      "value": "c0000000-0000-0000-0000-000000000003",
      "type": "string"
    },
    {
      "key": "userDId",
      "value": "d0000000-0000-0000-0000-000000000004",
      "type": "string"
    },
    {
      "key": "chatId",
      "value": "ff39d329-9646-4a0c-b360-a6e609ae7cff",
      "type": "string"
    },
    {
      "key": "groupChatId",
      "value": "6c43e2d1-90b5-47fa-b4f2-6d3c71b18477",
      "type": "string"
    },
    {
      "key": "messageId",
      "value": "sample-message-id",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        }
      }
    },
    {
      "name": "Create User (Dev Only)",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"New User\",\n  \"email\": \"new.user@example.com\"\n}"
        },
        "description": "Creates a new user in PostgreSQL. Available ONLY when NODE_ENV=development and AUTH_REQUIRED=false (returns 403 Forbidden in production or AUTH_REQUIRED=true).",
        "url": {
          "raw": "{{baseUrl}}/user",
          "host": ["{{baseUrl}}"],
          "path": ["user"]
        }
      }
    },
    {
      "name": "Get User by ID",
      "request": {
        "method": "GET",
        "header": [],
        "description": "Fetches user metadata from PostgreSQL. When AUTH_REQUIRED=true, the Bearer authToken JWT sub must match userId.",
        "url": {
          "raw": "{{baseUrl}}/user/{{userAId}}",
          "host": ["{{baseUrl}}"],
          "path": ["user", "{{userAId}}"]
        }
      }
    },
    {
      "name": "API 1: Create or Get Direct Chat",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userAId\": \"{{userAId}}\",\n  \"userBId\": \"{{userBId}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/chat/create",
          "host": ["{{baseUrl}}"],
          "path": ["chat", "create"]
        }
      }
    },
    {
      "name": "API 2: Send Message",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"senderId\": \"{{userAId}}\",\n  \"text\": \"Hello Bob, how are you?\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/chat/{{chatId}}/message/send",
          "host": ["{{baseUrl}}"],
          "path": ["chat", "{{chatId}}", "message", "send"]
        }
      }
    },
    {
      "name": "API 3: Get Messages (Chronological + Pagination)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-User-Id",
            "value": "{{userAId}}",
            "description": "Used in dev mode (AUTH_REQUIRED=false). When AUTH_REQUIRED=true, inherited Bearer {{authToken}} is used instead."
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/chat/{{chatId}}/messages?limit=50",
          "host": ["{{baseUrl}}"],
          "path": ["chat", "{{chatId}}", "messages"],
          "query": [
            {
              "key": "limit",
              "value": "50"
            },
            {
              "key": "cursor",
              "value": "",
              "disabled": true
            }
          ]
        }
      }
    },
    {
      "name": "API 4: Mark Message Read",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": \"{{userBId}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/chat/{{chatId}}/message/{{messageId}}/read",
          "host": ["{{baseUrl}}"],
          "path": ["chat", "{{chatId}}", "message", "{{messageId}}", "read"]
        }
      }
    },
    {
      "name": "API 5: Update Last Seen Message",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": \"{{userBId}}\",\n  \"messageId\": \"{{messageId}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/chat/{{chatId}}/lastseen",
          "host": ["{{baseUrl}}"],
          "path": ["chat", "{{chatId}}", "lastseen"]
        }
      }
    },
    {
      "name": "API 6: List User Chats",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/user/{{userAId}}/chats",
          "host": ["{{baseUrl}}"],
          "path": ["user", "{{userAId}}", "chats"]
        }
      }
    },
    {
      "name": "Bonus API 7: Create Group Chat",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"creatorId\": \"{{userAId}}\",\n  \"name\": \"Development Team\",\n  \"memberIds\": [\n    \"{{userBId}}\",\n    \"{{userCId}}\"\n  ]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/chat/group/create",
          "host": ["{{baseUrl}}"],
          "path": ["chat", "group", "create"]
        }
      }
    },
    {
      "name": "Bonus API 8: Add Group Members",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"requesterId\": \"{{userAId}}\",\n  \"memberIds\": [\n    \"{{userDId}}\"\n  ]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/chat/{{groupChatId}}/members",
          "host": ["{{baseUrl}}"],
          "path": ["chat", "{{groupChatId}}", "members"]
        }
      }
    },
    {
      "name": "Bonus API 9: Remove Group Member / Leave Group",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"requesterId\": \"{{userAId}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/chat/{{groupChatId}}/members/{{userBId}}",
          "host": ["{{baseUrl}}"],
          "path": ["chat", "{{groupChatId}}", "members", "{{userBId}}"]
        }
      }
    },
    {
      "name": "Bonus API 10: Update Group Information",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"requesterId\": \"{{userAId}}\",\n  \"name\": \"Updated Development Team\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/chat/{{groupChatId}}/group",
          "host": ["{{baseUrl}}"],
          "path": ["chat", "{{groupChatId}}", "group"]
        }
      }
    },
    {
      "name": "Bonus API 11: Edit Message",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"senderId\": \"{{userAId}}\",\n  \"text\": \"Updated message content\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/chat/{{chatId}}/message/{{messageId}}",
          "host": ["{{baseUrl}}"],
          "path": ["chat", "{{chatId}}", "message", "{{messageId}}"]
        }
      }
    },
    {
      "name": "Bonus API 12: Delete Message (Soft Delete)",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"senderId\": \"{{userAId}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/chat/{{chatId}}/message/{{messageId}}",
          "host": ["{{baseUrl}}"],
          "path": ["chat", "{{chatId}}", "message", "{{messageId}}"]
        }
      }
    }
  ]
}
