# Application Configuration
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# PostgreSQL Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=chat_system
DB_LOGGING=false
DB_SYNCHRONIZE=false

# Firebase / Firestore Configuration
# For local development or Firebase Emulator:
FIRESTORE_EMULATOR_HOST=
FIREBASE_PROJECT_ID=chat-system-dev
# Path to service account key file, or base64 encoded JSON
FIREBASE_SERVICE_ACCOUNT_KEY_PATH=
FIREBASE_SERVICE_ACCOUNT_KEY_BASE64=

# Security & CORS
# For production, replace '*' with explicit allowed origin(s) (e.g. https://app.example.com)
CORS_ORIGIN=*
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Auth Configuration
# WARNING: AUTH_REQUIRED=false is for local dev/assessment ONLY (NOT suitable for production).
# Production startup fails unless AUTH_REQUIRED=true and JWT_SECRET is >=32 random characters.
JWT_SECRET=replace-with-secure-random-32-plus-char-secret
AUTH_REQUIRED=false
